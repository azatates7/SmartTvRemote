{
  "expo": {
    "name": "SmartTvRemote",
    "slug": "SmartTvRemote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smarttvremote",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.azatates.smarttvremote",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "SmartTvRemote uses your local network to find and control TVs on the same Wi-Fi.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "CFBundleLocalizations": [
          "en",
          "tr"
        ]
      }
    },
    "android": {
      "package": "com.azatates.smarttvremote",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "locales": {
      "tr": "./locales/tr.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0C0D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "tr"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2711ca80-029e-4bc2-bea7-f7488de658f5"
      }
    },
    "owner": "azatates"
  }
}
